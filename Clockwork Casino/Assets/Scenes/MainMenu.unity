  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "-Rounds cost a stake of seconds. Read the rule given by the god of odds,
    then pick a card that fits the rule before time runs out.\n\n-Win: you\u2019re
    paid a multiple of the stake. Winnings clear Debt first, and any extra becomes
    Time Gained.\n\n-Lose / timeout: the stake is added to your Debt.\n\n-Borrow
    time to keep playing; it adds seconds now and the same amount to Debt. (You can
    enable Auto-Borrow to top up automatically.)\n\n-Hit 100% Debt = Sudden Death.
    A loss ends the run; a win must push Debt below 100% to survive. You can overflow
    past 100% once\u2014doing so triggers Sudden Death immediately.\n\n-When Debt
    = 0 between rounds, you may Cash Out to bank your Time Gained. Busting loses
    this run\u2019s Time Gained.\n\n-Some cards are cursed (they look \u201Coff\u201D\u2014reversed
    colors/odd ink). They never satisfy the rule; avoid them.\n\n-Optional Risk round
    (only when Debt = 0): double your Time Gained or lose it.\n\n-Rounds get harder
    over time. Borrow smart, spot curses, and know when to cash out."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d345fcb5e712208449d3866f556d7149, type: 2}
